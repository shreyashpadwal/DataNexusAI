# DataNexus AI — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and update as needed.
# NEVER put secrets here — all VITE_ variables are bundled into
# the public JavaScript that runs in the browser.

# Backend API base URL
# Local development:  http://localhost:8000
#   (Vite proxy forwards /api/* to this URL in dev mode)
# Production (Render): https://datanexus-ai-backend.onrender.com
#   (Replace with your actual Render service URL after deploying)
VITE_API_URL=http://localhost:8000
