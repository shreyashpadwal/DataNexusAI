# DataNexus AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/datanexus_ai

# Read-only analytics connection (can be same as DATABASE_URL in dev)
ANALYTICS_DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/datanexus_ai

# ── Groq LLM ──────────────────────────────────────────────────────
# Get your API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model to use — must be available on your Groq tier
# Options: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-20b

# ── JWT / Auth ────────────────────────────────────────────────────
# Secret key for signing JWT tokens — use a long random string in production
SECRET_KEY=your-secret-key-min-32-chars-change-in-production

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ───────────────────────────────────────────────────────────
# Directory to store uploaded CSV files (created automatically)
UPLOAD_DIR=uploads

# Max file upload size in MB
MAX_UPLOAD_SIZE_MB=10
