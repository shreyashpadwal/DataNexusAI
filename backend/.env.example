# DataNexus AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Set these as environment variables in your hosting platform.

# ── Database ──────────────────────────────────────────────────────
# Local PostgreSQL:
#   postgresql://postgres:your_password@127.0.0.1:5432/datanexus_ai
# Neon PostgreSQL (production):
#   postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/datanexus_ai?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/datanexus_ai

# Read-only analytics connection (can be same as DATABASE_URL in dev)
# In production, you may use the same Neon URL for both.
ANALYTICS_DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/datanexus_ai

# ── Groq LLM ──────────────────────────────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model to use — must be available on your Groq tier
# Options: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-20b

# ── JWT / Authentication ──────────────────────────────────────────
# IMPORTANT: Use a long random string in production (min 32 chars).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# On Render this is auto-generated — do not share or log this value.
SECRET_KEY=your-secret-key-min-32-chars-change-in-production

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:      http://localhost:5173,http://localhost:3000
# Production:     https://your-app.vercel.app
# Both:           http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Uploads ──────────────────────────────────────────────────
# Local dev: uploads  (relative — creates backend/uploads/)
# Production (Render): /tmp/datanexus_uploads  (always writable)
UPLOAD_DIR=uploads

# Max file upload size in MB (CSV files for ETL)
MAX_UPLOAD_SIZE_MB=10
